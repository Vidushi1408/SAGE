# SAGE Backend Configuration
PROJECT_NAME="SAGE — Smart Analytics & Growth Engine"

# Environment: 'production' disables /docs and refuses to boot with the default SECRET_KEY
ENVIRONMENT="development"

# Security
# Run `openssl rand -hex 32` to generate a secure secret key
SECRET_KEY="super_secret_key_change_me_in_production_1234567890"

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database
DATABASE_URL="postgresql://vidushibhadauria@localhost:5432/sage_db"

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/connectors/google/callback"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Anthropic Claude API Key
ANTHROPIC_API_KEY=""

# Local LLM via Ollama (https://ollama.com): run `ollama pull llama3.2:3b`, then set LLM_PROVIDER="ollama".
# Leave LLM_PROVIDER empty to auto-pick (Anthropic if a key is set, otherwise the built-in mock).
LLM_PROVIDER=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Resend (transactional email: password reset, team invites, anomaly alerts)
# Leave empty to use Mock Email mode (emails are logged, not sent)
RESEND_API_KEY=""
EMAIL_FROM="SAGE <insights@sage.dev>"
