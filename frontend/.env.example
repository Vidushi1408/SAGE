# SAGE Next.js Frontend Configuration

# URL pointing to SAGE Backend API root
# For local dev: http://localhost:8000
# For production: https://sage-backend.onrender.com (example)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Show the "Explore the demo" button on the sign-in page. Set to "false" to hide it
# (and set ENABLE_DEMO=false on the backend, which is already the default in production).
NEXT_PUBLIC_ENABLE_DEMO="true"
